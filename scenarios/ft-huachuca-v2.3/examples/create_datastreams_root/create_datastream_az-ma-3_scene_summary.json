{
  "name": "AZ-MA-3 Scene Summary",
  "description": "Scene summary.",
  "type": "observation",
  "live": true,
  "schema": {
    "obsFormat": "application/json",
    "resultSchema": {
      "type": "DataRecord",
      "definition": "https://os4csapi.org/def/csapi/scene/summaryRecordOSH",
      "label": "Scene summary",
      "fields": [
        {
          "name": "timestamp",
          "type": "Time",
          "definition": "https://os4csapi.org/def/odas/time/epochSeconds",
          "label": "Epoch seconds",
          "uom": {
            "code": "s",
            "label": "seconds"
          },
          "referenceTime": "1970-01-01T00:00:00Z"
        },
        {
          "name": "odasTimeStamp",
          "type": "Count",
          "definition": "https://os4csapi.org/def/odas/frameIndex",
          "label": "ODAS timeStamp/frame index"
        },
        {
          "name": "trackCount",
          "type": "Count",
          "definition": "https://os4csapi.org/def/csapi/trackCount",
          "label": "Active track count"
        },
        {
          "name": "activityLevel",
          "type": "Quantity",
          "definition": "https://os4csapi.org/def/csapi/activityLevel",
          "label": "Activity level",
          "uom": {
            "code": "1"
          },
          "constraint": {
            "type": "AllowedValues",
            "intervals": [
              [
                0,
                1
              ]
            ]
          }
        }
      ]
    }
  },
  "deployment@link": {
    "href": "/sensorhub/api/deployments/AZ-DEP-AZ-MA-3",
    "title": "AZ-DEP-AZ-MA-3",
    "type": "application/geo+json"
  },
  "procedure@link": {
    "href": "/sensorhub/api/procedures/AZ-MA-3-PROC-ODAS",
    "title": "AZ-MA-3-PROC-ODAS",
    "type": "application/geo+json"
  },
  "featureOfInterest@link": {
    "href": "/sensorhub/api/deployments/AZ-DEP-AOI-001",
    "title": "AOI",
    "type": "application/geo+json"
  },
  "phenomenonTimeInterval": "PT1S",
  "resultTimeInterval": "PT1S",
  "system@link": {
    "href": "/sensorhub/api/systems/AZ-MA-3",
    "title": "AZ-MA-3",
    "type": "application/geo+json"
  }
}
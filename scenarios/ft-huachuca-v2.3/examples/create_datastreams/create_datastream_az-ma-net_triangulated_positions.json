{
  "name": "AZ-MA-NET Triangulated Positions",
  "description": "Triangulated positions.",
  "type": "observation",
  "live": true,
  "schema": {
    "obsFormat": "application/json",
    "resultSchema": {
      "type": "DataRecord",
      "definition": "https://os4csapi.org/def/odas/fusion/triangulatedPositionRecordOSH",
      "label": "Triangulated position",
      "fields": [
        {
          "name": "timestamp",
          "type": "Time",
          "definition": "https://os4csapi.org/def/odas/time/epochSeconds",
          "label": "Epoch seconds",
          "uom": {
            "code": "s",
            "label": "seconds"
          },
          "referenceTime": "1970-01-01T00:00:00Z"
        },
        {
          "name": "globalTrackId",
          "type": "Text",
          "definition": "https://os4csapi.org/def/odas/globalTrackId",
          "label": "Global track id"
        },
        {
          "name": "lat",
          "type": "Quantity",
          "definition": "https://os4csapi.org/def/csapi/lat",
          "label": "Latitude",
          "uom": {
            "code": "deg"
          },
          "constraint": {
            "type": "AllowedValues",
            "intervals": [
              [
                -90,
                90
              ]
            ]
          }
        },
        {
          "name": "lon",
          "type": "Quantity",
          "definition": "https://os4csapi.org/def/csapi/lon",
          "label": "Longitude",
          "uom": {
            "code": "deg"
          },
          "constraint": {
            "type": "AllowedValues",
            "intervals": [
              [
                -180,
                180
              ]
            ]
          }
        },
        {
          "name": "posErrorM",
          "type": "Quantity",
          "definition": "https://os4csapi.org/def/csapi/posErrorM",
          "label": "Pos error",
          "uom": {
            "code": "m"
          }
        },
        {
          "name": "nSensors",
          "type": "Count",
          "definition": "https://os4csapi.org/def/csapi/nSensors",
          "label": "Contributing sensors"
        },
        {
          "name": "method",
          "type": "Text",
          "definition": "https://os4csapi.org/def/csapi/method",
          "label": "Method"
        }
      ]
    }
  },
  "deployment@link": {
    "href": "/sensorhub/api/deployments/AZ-DEP-NET-001",
    "title": "AZ-DEP-NET-001",
    "type": "application/geo+json"
  },
  "procedure@link": {
    "href": "/sensorhub/api/procedures/AZ-PROC-TRIANG",
    "title": "AZ-PROC-TRIANG",
    "type": "application/geo+json"
  },
  "featureOfInterest@link": {
    "href": "/sensorhub/api/deployments/AZ-DEP-AOI-001",
    "title": "AOI",
    "type": "application/geo+json"
  },
  "phenomenonTimeInterval": "PT1S",
  "resultTimeInterval": "PT1S"
}
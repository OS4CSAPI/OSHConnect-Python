{
  "name": "AZ-MA-3 SSL Potential Sources",
  "description": "SSL raw.",
  "type": "observation",
  "live": true,
  "schema": {
    "obsFormat": "application/json",
    "resultSchema": {
      "type": "DataRecord",
      "definition": "https://os4csapi.org/def/odas/ssl/potentialSourcesRecordOSH",
      "label": "SSL potential sources",
      "fields": [
        {
          "name": "timestamp",
          "type": "Time",
          "definition": "https://os4csapi.org/def/odas/time/epochSeconds",
          "label": "Epoch seconds",
          "uom": {
            "code": "s",
            "label": "seconds"
          },
          "referenceTime": "1970-01-01T00:00:00Z"
        },
        {
          "name": "odasTimeStamp",
          "type": "Count",
          "definition": "https://os4csapi.org/def/odas/frameIndex",
          "label": "ODAS timeStamp/frame index"
        },
        {
          "name": "src",
          "type": "DataArray",
          "definition": "https://os4csapi.org/def/odas/ssl/potentialSourceArray",
          "label": "Potential sources",
          "elementType": {
            "name": "element",
            "type": "DataRecord",
            "definition": "https://os4csapi.org/def/odas/ssl/potentialSource",
            "label": "SSL potential source",
            "fields": [
              {
                "name": "x",
                "type": "Quantity",
                "definition": "https://os4csapi.org/def/odas/directionCosineX",
                "label": "Direction cosine X",
                "uom": {
                  "code": "1"
                },
                "constraint": {
                  "type": "AllowedValues",
                  "intervals": [
                    [
                      -1,
                      1
                    ]
                  ]
                }
              },
              {
                "name": "y",
                "type": "Quantity",
                "definition": "https://os4csapi.org/def/odas/directionCosineY",
                "label": "Direction cosine Y",
                "uom": {
                  "code": "1"
                },
                "constraint": {
                  "type": "AllowedValues",
                  "intervals": [
                    [
                      -1,
                      1
                    ]
                  ]
                }
              },
              {
                "name": "z",
                "type": "Quantity",
                "definition": "https://os4csapi.org/def/odas/directionCosineZ",
                "label": "Direction cosine Z",
                "uom": {
                  "code": "1"
                },
                "constraint": {
                  "type": "AllowedValues",
                  "intervals": [
                    [
                      -1,
                      1
                    ]
                  ]
                }
              },
              {
                "name": "E",
                "type": "Quantity",
                "definition": "https://os4csapi.org/def/odas/relativeEnergy",
                "label": "Relative energy (ODAS)",
                "uom": {
                  "code": "1"
                }
              }
            ]
          }
        }
      ]
    }
  },

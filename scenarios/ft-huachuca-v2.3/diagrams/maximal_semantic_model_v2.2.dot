digraph G {
rankdir=LR;
AOI[label="AZ-DEP-AOI-001\nDeployment (AOI polygon)"];
NET[label="AZ-MA-NET\nSystem (container)"];
PROP[label="/properties\n(Property definitions)"];
DEP_SYS[label="DeployedSystem\n(deployment ↔ system)"];
